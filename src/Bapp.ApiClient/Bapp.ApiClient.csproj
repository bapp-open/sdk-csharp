<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Bapp.ApiClient</RootNamespace>
    <AssemblyName>Bapp.ApiClient</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Bapp.ApiClient</PackageId>
    <Version>0.5.0</Version>
    <Authors>BAPP</Authors>
    <Description>Official .NET client for the BAPP Auto API: authentication, entity CRUD, document views, tasks and file uploads.</Description>
    <PackageTags>bapp;erp;api;client;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.bapp.ro/developers/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bapp-open/sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
